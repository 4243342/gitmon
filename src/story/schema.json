{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "characters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["name", "role", "color", "defaultSprite"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 20 },
          "role": { "type": "string", "enum": ["protagonist", "narrator", "guide", "boss", "support"] },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "defaultSprite": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      }
    },
    "lines": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1, "maxLength": 200 }
    }
  }
}
