import { useEffect, useState } from 'react'
import { AnimatePresence, motion } from 'framer-motion'
import { hatch } from './engine.js'
import HoloCard from './components/HoloCard.jsx'
import PackStage from './components/PackStage.jsx'
import PixelSprite from './components/PixelSprite.jsx'
import './styles.css'

// 支持 ?repo=owner/repo&view=card|pack 直接进入某个状态（分享/调试用）
function readInitial() {
  try {
    const params = new URLSearchParams(window.location.search)
    const repo = params.get('repo')
    if (!repo) return null
    const pet = hatch(repo)
    if (!pet) return null
    const v = params.get('view')
    return {
      pet,
      url: repo,
      view: v === 'pack' ? 'pack' : v === 'card' ? 'card' : 'home',
      collection: v === 'card' ? [pet] : [],
    }
  } catch {
    return null
  }
}

export default function App() {
  const boot = readInitial()
  const [view, setView] = useState(boot?.view ?? 'home') // home | pack | card
  const [url, setUrl] = useState(boot?.url ?? '')
  const [error, setError] = useState('')
  const [pet, setPet] = useState(boot?.pet ?? null)
  const [collection, setCollection] = useState(boot?.collection ?? [])

  const doHatch = () => {
    const result = hatch(url)
    if (!result) {
      setError('无法识别的地址 · 请粘贴 GitHub 或 Gitee 仓库链接')
      return
    }
    setError('')
    setPet(result)
    setView('pack')
  }

  const onPackDone = () => {
    setCollection((c) => (c.some((p) => p.fullName === pet.fullName) ? c : [...c, pet]))
    setView('card')
  }

  const reset = () => {
    setView('home')
    setUrl('')
    setPet(null)
    setError('')
  }

  // 调试/分享直达逻辑已在 readInitial() 中同步处理，无需 effect

  return (
    <div className="app">
      <div className="aurora" />
      <div className="grid-noise" />

      <header className="topbar">
        <div className="brand" onClick={reset}>
          <span className="brand-mark" />
          <span className="brand-text">GitMon</span>
        </div>
        <nav className="topnav">
          <span className="nav-pill">{collection.length} 只已收集</span>
        </nav>
      </header>

      <AnimatePresence mode="wait">
        {view === 'home' && (
          <motion.main
            key="home"
            className="home"
            initial={{ opacity: 0, y: 14 }}
            animate={{ opacity: 1, y: 0 }}
            exit={{ opacity: 0, y: -10 }}
            transition={{ duration: 0.35 }}
          >
            <section className="hero">
              <div className="hero-eyebrow">REPO → CREATURE</div>
              <h1>
                你的仓库，
                <br />
                是一只<span className="grad-text">活着的精灵</span>
              </h1>
              <p className="hero-sub">
                输入一个 GitHub / Gitee 仓库，扫描后生成卡包。品种由技术栈决定，品质由代码质量决定，等级由工程量决定。
              </p>

              <div className="hatch-box">
                <input
                  value={url}
                  onChange={(e) => setUrl(e.target.value)}
                  onKeyDown={(e) => e.key === 'Enter' && doHatch()}
                  placeholder="github.com/owner/repo　或　gitee.com/owner/repo"
                  spellCheck={false}
                />
                <button onClick={doHatch}>
                  孵化
                  <span className="btn-arrow">→</span>
                </button>
              </div>
              {error && <div className="error">{error}</div>}

              <div className="chips">
                <span className="chips-label">试试</span>
                {[
                  { label: 'facebook/react', url: 'https://github.com/facebook/react' },
                  { label: 'rust-lang/rust', url: 'https://github.com/rust-lang/rust' },
                  { label: 'gitee/mirrors-vue', url: 'https://gitee.com/mirrors/vue' },
                ].map((c) => (
                  <button key={c.label} className="chip" onClick={() => setUrl(c.url)}>
                    {c.label}
                  </button>
                ))}
              </div>
            </section>

            <section className="how">
              {[
                { n: '01', t: '扫描', d: '技术栈、语言占比、依赖与项目结构' },
                { n: '02', t: '判定', d: '品种 / 品质 / 等级 / 六维一次算清' },
                { n: '03', t: '开包', d: '撕开箔膜，精灵破壳登场' },
              ].map((s) => (
                <div key={s.n} className="how-card">
                  <span className="how-n">{s.n}</span>
                  <h3>{s.t}</h3>
                  <p>{s.d}</p>
                </div>
              ))}
            </section>

            {collection.length > 0 && (
              <section className="dex">
                <h2>图鉴 <span className="dex-count">{collection.length}</span></h2>
                <div className="dex-grid">
                  {collection.map((p) => (
                    <button
                      key={p.fullName}
                      className={`dex-item q-${p.quality.key}`}
                      style={{ '--q': p.quality.color }}
                      onClick={() => { setPet(p); setView('card') }}
                    >
                      <PixelSprite pet={p} size={56} animate={false} />
                      <span className="dex-name">{p.repo}</span>
                      <span className="dex-meta">Lv.{p.level} · {p.quality.key}</span>
                    </button>
                  ))}
                </div>
              </section>
            )}
          </motion.main>
        )}

        {view === 'pack' && pet && (
          <motion.main
            key="pack"
            className="pack-wrap"
            initial={{ opacity: 0, scale: 0.96 }}
            animate={{ opacity: 1, scale: 1 }}
            exit={{ opacity: 0, scale: 1.04 }}
            transition={{ duration: 0.3 }}
          >
            <PackStage pet={pet} onDone={onPackDone} />
          </motion.main>
        )}

        {view === 'card' && pet && (
          <motion.main
            key="card"
            className="card-wrap"
            initial={{ opacity: 0 }}
            animate={{ opacity: 1 }}
            exit={{ opacity: 0 }}
          >
            <div className="reveal-line" style={{ '--q': pet.quality.color }}>
              {pet.quality.name} · {pet.element.name}系{pet.species.name}　登场
            </div>
            <HoloCard pet={pet} />
            <div className="card-actions">
              <button className="ghost" onClick={reset}>再孵一只</button>
              <button className="ghost" onClick={() => setView('home')}>回到首页</button>
            </div>
          </motion.main>
        )}
      </AnimatePresence>

      <footer className="footer">
        GitMon prototype · 开包引擎 pack-opener-js · 立绘种子确定性生成
      </footer>
    </div>
  )
}
