# 复制为 .env 或直接 export 到环境变量

# ---------- 登录授权（GitHub OAuth） ----------
# 在 https://github.com/settings/developers 新建 OAuth App：
#   Homepage URL          http://127.0.0.1:8000
#   Authorization callback http://127.0.0.1:8000/api/auth/github/callback
# 不配置也能用：首页可以让用户粘贴个人访问令牌登录（同样是 5000 次/小时）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 对外访问前缀，决定 OAuth 回调地址（部署到公网要改成 https://your.domain）
GITMON_PUBLIC_URL=http://127.0.0.1:8000
# 登录成功后跳回哪（默认回 GITMON_PUBLIC_URL 根路径；用 vite 5173 开发时可设为 http://127.0.0.1:5173）
GITMON_WEB_URL=
# 会话与令牌加密密钥（留空则自动生成 data/secret.key）
GITMON_SECRET=
# 会话有效期（秒），默认 30 天
GITMON_SESSION_TTL=2592000

# ---------- 服务端兜底令牌 ----------
# GitHub Personal Access Token（匿名配额 60 次/小时，只够 4~5 次扫描；登录用户会用自己的令牌优先）
GITHUB_TOKEN=

# Gitee 私人令牌（匿名配额较低，建议配置）
GITEE_TOKEN=

# SQLite 与立绘目录（默认 backend/data）
GITMON_DATA_DIR=./data

# 快照缓存时长（秒），默认 6 小时
GITMON_CACHE_TTL=21600

# 每日同步（1 开 0 关）
GITMON_DAILY_SYNC=0

# 允许的前端来源，逗号分隔；* 表示全部（开发用）
GITMON_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 单个 IP 每分钟请求上限（0 = 不限）
GITMON_RATE_LIMIT=120

# 是否允许浅克隆 + scc 精确统计（默认关闭，用 Git 树尺寸估算更快）
GITMON_USE_SCC=0

# 是否在浅克隆后跑一次离线 AI 味检测（依赖 GITMON_USE_SCC=1，检测结果只影响「根基」）
GITMON_AI_TRACE=0

# 立绘风格：rich（32×32，默认）/ classic（16×16，与旧版前端 canvas 一致）
GITMON_SPRITE_STYLE=rich
